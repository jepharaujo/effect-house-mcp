{
  "name": "effect-house-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server that bridges AI agents to TikTok Effect House through the editor's own eh kernel.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "effect-house-mcp": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/index.js",
    "doctor": "node dist/src/index.js doctor",
    "docs:index": "node dist/src/index.js index-docs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "effect-house",
    "tiktok",
    "ar",
    "claude-code",
    "codex"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
